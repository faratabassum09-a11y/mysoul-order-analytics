MONGO_URI=mongodb://127.0.0.1:27017/lead_fms
PORT=5000

# Comma-separated list of allowed frontend origins in production, e.g. https://your-app.vercel.app
# Leave unset for local dev (allows all).
FRONTEND_URL=

# Required. A long random string used to sign logins — anyone who has it can forge a login, so keep it
# secret and never commit a real value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Follow-up times are planned in this time zone (minutes from UTC; India = 330) and the nightly
# snapshot runs at 23:55 in TZ_NAME.
TZ_OFFSET_MIN=330
TZ_NAME=Asia/Kolkata
