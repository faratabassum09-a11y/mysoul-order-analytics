PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/mysoul_orders

# Optional shared password for the dashboard (recommended: the data holds customer names).
# Leave empty to disable.
ACCESS_PASSWORD=

# ---- Google Sheet ("Shopify New Order") ----
SHEET_ID=
SHEET_ORDER_TAB=Order Sheet
SHEET_MASTER_TAB=OrdersMaster

# SHEET_SOURCE=csv  -> sheet shared as "Anyone with the link can view"; no credentials needed.
#                      Set the tab gids (the number after gid= in the sheet URL) for exact tabs.
# SHEET_SOURCE=api  -> private sheet; share it with the service account email (Viewer).
# SHEET_SOURCE=none -> no automatic fetch; upload CSV exports from the Settings page.
SHEET_SOURCE=csv
SHEET_ORDER_GID=
SHEET_MASTER_GID=
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# or paste the JSON on one line:
GOOGLE_SERVICE_ACCOUNT_JSON=

# Auto-sync every N minutes. Defaults to 15 when left out. 0 = manual only.
SYNC_INTERVAL_MIN=15

# Secret for the external trigger URL:  GET /api/cron/sync?key=<this value>
# Needed on hosts that sleep (Render free plan). Use a long random string.
CRON_SECRET=
# The trigger URL skips the sync if the last successful check was newer than this many minutes.
CRON_MIN_AGE_MIN=5
