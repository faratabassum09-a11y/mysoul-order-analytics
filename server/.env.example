PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/mysoul_orders

# Optional shared password for the dashboard (recommended: the data holds customer names).
# Leave empty to disable.
ACCESS_PASSWORD=

# ---- Google Sheet ("Shopify New Order") ----
SHEET_ID=
SHEET_ORDER_TAB=Order Sheet
SHEET_MASTER_TAB=OrdersMaster

# SHEET_SOURCE=csv  -> sheet shared as "Anyone with the link can view"; no credentials needed.
#                      Set the tab gids (the number after gid= in the sheet URL) for exact tabs.
# SHEET_SOURCE=api  -> private sheet; share it with the service account email (Viewer).
# SHEET_SOURCE=none -> no automatic fetch; upload CSV exports from the Settings page.
SHEET_SOURCE=csv
SHEET_ORDER_GID=
SHEET_MASTER_GID=
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# or paste the JSON on one line:
GOOGLE_SERVICE_ACCOUNT_JSON=

# Auto-sync every N minutes. Defaults to 15 when left out. 0 = manual only.
SYNC_INTERVAL_MIN=15

# Secret for the external trigger URL:  GET /api/cron/sync?key=<this value>
# Needed on hosts that sleep (Render free plan). Use a long random string.
CRON_SECRET=
# The trigger URL skips the sync if the last successful check was newer than this many minutes.
CRON_MIN_AGE_MIN=5

# ---- Shopify (customer details and items per order) ----
# From your app in the Shopify Dev Dashboard (Settings page). Keep these ONLY in the host's environment, never in git.
# Store subdomain only: for https://my-store.myshopify.com use my-store
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional
SHOPIFY_API_VERSION=2026-04
# Pull new and changed orders every N minutes (also runs after every sheet change). 0 = only after sheet changes and by button.
SHOPIFY_SYNC_INTERVAL_MIN=2
# Linking a store that is NOT in your Dev Dashboard organization (install-link flow):
# permissions requested (add read_all_orders once Shopify has approved it for the app) and the server's public address.
SHOPIFY_SCOPES=read_orders,read_customers
# Render fills RENDER_EXTERNAL_URL by itself; set PUBLIC_URL only on other hosts. No trailing slash.
PUBLIC_URL=
# Tokens are renewed automatically. Set 0 only if Shopify refuses expiring tokens for your app.
SHOPIFY_EXPIRING_TOKENS=1

# ---- Shipway (dispatch and tracking status per order) ----
# SHIPWAY_USERNAME is your Shipway login email. SHIPWAY_LICENSE_KEY is under Shipway > Profile > Manage profile (NOT the password).
# Keep both ONLY in the host's environment, never in git.
SHIPWAY_USERNAME=
SHIPWAY_LICENSE_KEY=
# Optional. number = orders were pushed as 1874, hash = as #1874, auto = try both.
SHIPWAY_ORDER_ID_FORMAT=auto
# Refresh tracking status every N minutes. 0 = only by button.
SHIPWAY_SYNC_INTERVAL_MIN=10
